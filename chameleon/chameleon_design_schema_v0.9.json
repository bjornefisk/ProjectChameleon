{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adobe.com/chameleon/schema/v0.9/design.json",
  "title": "CHAMELEON Design Document (v0.9 — ratified Stage 1 contract)",
  "description": "A single design: a canvas plus its ordered list of elements. Used for the source design and the resized design; semantic identity, mutability, geometry, and renderer rules are defined in Docs/PROJECT_CONTRACT.md.",
  "type": "object",
  "required": ["canvas", "elements"],
  "additionalProperties": false,
  "properties": {
    "canvas": { "$ref": "#/$defs/canvas" },
    "elements": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/element" }
    }
  },
  "$defs": {
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width":  { "type": "integer", "minimum": 1, "description": "px" },
        "height": { "type": "integer", "minimum": 1, "description": "px" }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "type", "x", "y", "width", "height"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable non-empty identifier. The engine must return every input id exactly once — it cannot add, remove, or invent elements."
        },
        "type": { "type": "string", "enum": ["text", "image", "shape"] },
        "x": { "type": "number", "description": "Left edge, px, from canvas top-left." },
        "y": { "type": "number", "description": "Top edge, px." },
        "width":  { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "rotation": { "type": "number", "default": 0, "description": "Degrees, clockwise, about the element's center." },
        "opacity":  { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "z_index":  { "type": "integer", "description": "Stacking order \u2014 higher paints on top." },
        "group_id": {
          "type": ["string", "null"],
          "default": null,
          "description": "Elements sharing a group_id are a designer-intended unit (e.g. a button's background shape + its label). The engine is NOT told what the group means \u2014 only that these pieces are meant to travel together. This is the semantic-gap constraint made concrete."
        },

        "content":        { "type": "string", "description": "text only \u2014 the literal string." },
        "font_family":    { "type": "string", "description": "text only" },
        "font_size":      { "type": "number", "minimum": 1, "description": "text only, px. Stage 1 may change this value; the response serializer emits an integer." },
        "font_weight":    { "type": "string", "enum": ["regular", "bold"], "default": "regular", "description": "text only" },
        "font_style":     { "type": "string", "enum": ["normal", "italic"], "default": "normal", "description": "text only" },
        "color":          { "type": "string", "description": "text/shape \u2014 CSS-style rgba(), e.g. rgba(255,255,255,1)." },
        "text_align":     { "type": "string", "enum": ["left", "center", "right"], "default": "left", "description": "text only" },
        "line_height":    { "type": "number", "exclusiveMinimum": 0, "default": 1.2, "description": "text only, positive multiplier" },
        "letter_spacing": { "type": "number", "default": 0, "description": "text only, px; may be negative" },
        "max_lines":      { "type": ["integer", "null"], "minimum": 1, "default": null, "description": "text only — optional positive cap enforced by the project adapter; it never truncates content." },
        "style_runs": {
          "type": "array",
          "description": "text only, optional. Per-character overrides for things like a two-color headline. 0-based, end-exclusive indices into `content`.",
          "items": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": { "type": "integer", "minimum": 0 },
              "end":   { "type": "integer", "minimum": 0, "description": "End-exclusive index; semantic validation requires end <= content length." },
              "color": { "type": "string" },
              "font_weight": { "type": "string", "enum": ["regular", "bold"] },
              "font_style":  { "type": "string", "enum": ["normal", "italic"] }
            }
          }
        },

        "asset_id": { "type": "string", "description": "image only \u2014 references a file in the design's /assets folder. The engine never invents pixels; it only repositions/resizes this asset." },
        "fit": { "type": "string", "enum": ["contain", "cover", "fill"], "default": "contain", "description": "image only; fit affects renderer pixels, not the Stage 1 foreground box-ratio invariant" },

        "shape_type":    { "type": "string", "enum": ["rectangle", "ellipse", "line"], "description": "shape only" },
        "fill_color":    { "type": "string", "description": "shape only" },
        "stroke_color":  { "type": ["string", "null"], "default": null, "description": "shape only" },
        "stroke_width":  { "type": "number", "minimum": 0, "default": 0, "description": "shape only" },
        "corner_radius": { "type": "number", "minimum": 0, "default": 0, "description": "shape only, rectangles" }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "text" } } },
          "then": { "required": ["content", "font_family", "font_size", "color"] } },
        { "if": { "properties": { "type": { "const": "image" } } },
          "then": { "required": ["asset_id"] } },
        { "if": { "properties": { "type": { "const": "shape" } } },
          "then": { "required": ["shape_type", "fill_color"] } }
      ]
    }
  }
}
